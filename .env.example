# Configuration d'exemple pour les variables sensibles
# Copier ce fichier vers .env et remplir avec vos vraies valeurs
# NE JAMAIS commiter .env en production

# Configuration SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lucasmengue320@gmail.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=tls
FROM_NAME=Association des Miss du Gabon
FROM_MAIL=lucasmengue320@gmail.com

# Adresses email de destination
EMAIL_CONTACT=lucasmengue320@gmail.com
EMAIL_SUPPORT=lucasmengue320@gmail.com
EMAIL_PARTNERSHIPS=lucasmengue320@gmail.com
EMAIL_ADMIN=lucasmengue320@gmail.com

# Configuration du site
SITE_NAME=Association des Miss du Gabon
SITE_URL=https://www.missgarbon.ga

# Sécurité
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Base de données (optionnel)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=miss_gabon

# Mode debug
DEBUG_MODE=false
